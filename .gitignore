# Node / Vite
node_modules/
dist/
dist-ssr/
dist-portable/
# 交付产物（MSI / 便携 ZIP）：体积大、可复现，不入库；路径与大小记在 docs/08
dist-release/
*.local
*.tsbuildinfo
node_modules/.cache/

# Rust / Cargo build artifacts
/target/
/src-tauri/target/

# Tauri generated schema files
/src-tauri/gen/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Trae / 其他编码工具的工作目录与报告（本机工具产物，不属于项目内容）
.trae/
.trae-html-share-packages/
.workbuddy/
.zcode/

# Secrets / env files (禁止入库，见 AGENTS.md §3)
.env
.env.*
*.pem
*.key
测试API.txt

# 一次性原型/脚本（AGENTS §7：不并入主代码路径）
scratch/

# 一次性真机排查脚本（`*_repro.rs`）：人工前置（本机 AppContainer 档 + `REPRO_WS` 指向
# 手工准备的干净快照），直接 `cargo test` 会 panic，不是可自证的常驻测试；输出的数字已
# 记在 docs/14:204 与 docs/16。文件留在工作树供沙箱改造那条线继续用，不入库。
src-tauri/tests/sandbox_container_repro.rs
src-tauri/tests/sandbox_repo_build_repro.rs

# 真机验收截图/取证产物（体积大、可复现，状态记在 docs/05）
artifacts/

# 评估运行产物：唯一形态是 `evals/results/<epoch>-<pid>-<role>.json`（一进程一份，
# 入库会 churn）。门禁 `evals/score.mjs` 只接受显式传入的两份 results 文件。
evals/results/
# 旧单文件产物（2026-11-09 之前）：已无消费方，score.mjs 不再兜底读取——它读到的
# 会是别的进程留下的数字。留在磁盘上仅供历史对照，删不删都不影响任何门禁。
evals/latest.json
evals/control.json
evals/.eval.lock
evals/*.log

# 上游对齐账本的 JSON 产物：本地/CI 读，不入库。理由有两条——
# ① 三万行生成物入库后，真实漂移的 diff 会被机器重排淹没；
# ② 它会变成与 overrides.json 并列的"第二个真源"，出现改 ledger 不改 overrides。
# 人读的 align/ledger.md 仍入库，过期由 `pnpm align:report --check` 在 CI 拦住。
align/ledger.json
