# Node / Vite
node_modules/
dist/
dist-ssr/
dist-portable/
# 交付产物（MSI / 便携 ZIP）：体积大、可复现，不入库；路径与大小记在 docs/08
dist-release/
*.local
*.tsbuildinfo
node_modules/.cache/

# Rust / Cargo build artifacts
/target/
/src-tauri/target/

# Tauri generated schema files
/src-tauri/gen/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Trae / 其他编码工具的工作目录与报告（本机工具产物，不属于项目内容）
.trae/
.trae-html-share-packages/
.workbuddy/
.zcode/

# Secrets / env files (禁止入库，见 AGENTS.md §3)
.env
.env.*
*.pem
*.key
测试API.txt

# 一次性原型/脚本（AGENTS §7：不并入主代码路径）
scratch/

# 真机验收截图/取证产物（体积大、可复现，状态记在 docs/05）
artifacts/

# 评估运行产物（一进程一份，入库会churn）
evals/latest.json
# 已无消费方：workflow 改为跑当日两臂并显式传路径（分母必须是同日对照，
# 冻结基线会因端点漂移失真）。仅作历史保留，删不删都不影响任何门禁。
evals/control.json
evals/results/
evals/.eval.lock
evals/*.log

# 上游对齐账本的 JSON 产物：本地/CI 读，不入库。理由有两条——
# ① 三万行生成物入库后，真实漂移的 diff 会被机器重排淹没；
# ② 它会变成与 overrides.json 并列的"第二个真源"，出现改 ledger 不改 overrides。
# 人读的 align/ledger.md 仍入库，过期由 `pnpm align:report --check` 在 CI 拦住。
align/ledger.json
