+/// 错误体里明确点名「上下文/窗口被撑爆」的措辞。
+///
+/// 分两档：结构化措辞（自带 `context length` 之类定语）直接命中；只说
+/// “令牌太多”这种含糊措辞则要先排除限流语境——TPM 限额的报错同样是
+/// “too many tokens”，那是限流，不是上下文超限。
+fn context_overflow_hit(code: Option<&str>, message: Option<&str>) -> bool {
+    let haystack = format!("{} {}", code.unwrap_or_default(), message.unwrap_or_default()).to_ascii_lowercase();
+    const STRICT: &[&str] = &[
+        "context_length_exceeded",
+        "context length",
+        "context window",
+        "context_window",
+        "context_overflow",
+        "context overflow",
+        "maximum context",
+        "上下文长度",
+        "上下文窗口",
+        "上下文超限",
+    ];
+    if STRICT.iter().any(|needle| haystack.contains(needle)) {
+        return true;
+    }
+    const RATE_WORDING: &[&str] = &["rate limit", "rate_limit", "per minute", "per min", "tpm", "rpm"];
+    if RATE_WORDING.iter().any(|needle| haystack.contains(needle)) {
+        return false;
+    }
+    const LOOSE: &[&str] = &["too many tokens", "token count exceeds", "prompt is too long", "input is too long"];
+    LOOSE.iter().any(|needle| haystack.contains(needle))
+}
